{
  // Cloudflare Workers Static Assets. No Worker script: this product has no
  // request-time code, so `assets.directory` is the whole deployment and
  // asset requests never reach (or bill for) a Worker.
  //
  // `pnpm build` writes ./out, and `public/_headers` and `public/_redirects`
  // are copied into it verbatim — Cloudflare reads both from the asset root.
  "name": "personal-interface",
  "compatibility_date": "2026-09-03",

  "assets": {
    "directory": "./out",

    // The export writes flat files: `out/ko/practice.html`, and links are
    // written `href="/ko/practice"` with no trailing slash. `auto-trailing-slash`
    // is the default and the one that matches: an individual .html file is
    // canonical WITHOUT a slash, and a folder index WITH one.
    //
    // Stated explicitly rather than left to the default because this export
    // has an unusual shape — `out/ko/practice.html` and `out/ko/practice/`
    // (holding the RSC payload for client navigation) both exist. See
    // docs/PRODUCTION.md for what to check on the first deploy.
    "html_handling": "auto-trailing-slash",

    // `out/404.html` is generated by the export. This is what replaces the
    // `app/[lang]/[...rest]` catch-all route, which static export cannot
    // build — a catch-all cannot enumerate the URLs that do not exist.
    "not_found_handling": "404-page"
  }
}
