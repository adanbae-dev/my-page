{
  "name": "personal-interface",
  "version": "0.0.0",
  "private": true,
  "description": "PERSONAL INTERFACE — an interface for a life in progress.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run sync:headers && next build && pnpm run sync:404",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run check:contrast && pnpm run check:content && pnpm run check:practice && pnpm run check:cartogram",
    "check:budget": "node scripts/check-budget.mjs",
    "verify": "pnpm run check && pnpm run build && pnpm run check:layers && pnpm run check:motion && pnpm run check:budget",
    "check:layers": "node scripts/check-layers.mjs",
    "check:content": "node scripts/check-content.mjs",
    "sync:git": "node scripts/sync-git.mjs",
    "check:release": "node scripts/check-release.mjs",
    "release": "pnpm run verify && pnpm run check:release",
    "check:motion": "node scripts/check-motion.mjs",
    "sync:perf": "node scripts/sync-perf.mjs",
    "check:practice": "node scripts/check-practice.mjs",
    "sync:headers": "node scripts/sync-headers.mjs",
    "deploy": "wrangler deploy",
    "sync:404": "node scripts/sync-404.mjs",
    "check:cartogram": "node scripts/check-cartogram.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "gray-matter": "4.0.3",
    "next": "16.3.2",
    "next-mdx-remote": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/d3-hexbin": "^0.2.5",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "22.19.2",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "d3-hexbin": "^0.2.2",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "typescript": "5.9.3",
    "wrangler": "^4.128.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
