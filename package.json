{
  "name": "personal-interface",
  "version": "0.0.0",
  "private": true,
  "description": "PERSONAL INTERFACE — an interface for a life in progress.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run check:contrast",
    "check:budget": "node scripts/check-budget.mjs",
    "verify": "pnpm run check && pnpm run build && pnpm run check:layers && pnpm run check:budget",
    "check:layers": "node scripts/check-layers.mjs"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.19.2",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
