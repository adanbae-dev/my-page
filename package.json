{
  "name": "personal-interface",
  "version": "0.0.0",
  "private": true,
  "description": "PERSONAL INTERFACE — an interface for a life in progress.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run check:contrast && pnpm run check:content",
    "check:budget": "node scripts/check-budget.mjs",
    "verify": "pnpm run check && pnpm run build && pnpm run check:layers && pnpm run check:motion && pnpm run check:budget",
    "check:layers": "node scripts/check-layers.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:release": "node scripts/check-release.mjs",
    "release": "pnpm run verify && pnpm run check:release",
    "check:motion": "node scripts/check-motion.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "gray-matter": "4.0.3",
    "next": "16.3.2",
    "next-mdx-remote": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "22.19.2",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
